  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#929080", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#D2C185" } },
    { "scope": ["constant", "constant.language", "entity.name.constant"], "settings": { "foreground": "#D49A7B" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#B8C28D" } },
    { "scope": ["constant.numeric", "constant.character", "constant.other"], "settings": { "foreground": "#D6AA70" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#A5B9BF" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#C49DA8" } },
    { "scope": ["variable", "variable.parameter", "entity.name.variable"], "settings": { "foreground": "#D9D3C3" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#E18A78" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#D2C185" } },
    { "scope": ["support.type.property-name", "entity.name.label"], "settings": { "foreground": "#A5B9BF" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#E18A78", "fontStyle": "underline" } }
  ],
  "semanticTokenColors": {
    "excludedCode": {
      "foreground": "#C2BCA9"
    }
  }
}