  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6B675A", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#5C4D20" } },
    { "scope": ["constant", "constant.language", "entity.name.constant"], "settings": { "foreground": "#82432F" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#4D5A2B" } },
    { "scope": ["constant.numeric", "constant.character", "constant.other"], "settings": { "foreground": "#874B1E" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#3F5D68" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#754D5B" } },
    { "scope": ["variable", "variable.parameter", "entity.name.variable"], "settings": { "foreground": "#36352E" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#8B382E" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#665C2C" } },
    { "scope": ["support.type.property-name", "entity.name.label"], "settings": { "foreground": "#3F5D68" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#8B382E", "fontStyle": "underline" } }
  ],
  "semanticTokenColors": {
    "excludedCode": {
      "foreground": "#514D42"
    }
  }
}